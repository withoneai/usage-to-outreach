# Your One API key. After `one init`, find it in ~/.one/config.json (apiKey)
# or in the dashboard at https://app.withone.ai
ONE_SECRET=

# Your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Connection keys from `one --agent list` (the `key` field for each platform)
ONE_CONNECTION_STRIPE=
ONE_CONNECTION_POSTHOG=
ONE_CONNECTION_GMAIL=

# Your PostHog project ID (Project settings -> General -> Project ID)
POSTHOG_PROJECT_ID=

# Optional: the event property that carries the Stripe customer id, set on
# every event your app sends to PostHog (default: stripe_customer_id). This
# is the only thing joining the two platforms; see README, "The join".
# USAGE_PROPERTY=stripe_customer_id

# Optional: percent change over the trailing week that counts as a spike or
# a crater (defaults: +50 and -50)
# SPIKE_THRESHOLD_PCT=50
# CRATER_THRESHOLD_PCT=-50

# Optional: events in the baseline week below which an account is too quiet
# to read anything into either way (default 5)
# MIN_BASELINE_EVENTS=5

# Optional: override the Claude model (default claude-opus-5)
# CLAUDE_MODEL=claude-opus-5
